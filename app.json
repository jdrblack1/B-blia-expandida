{
  "expo": {
    "name": "Bíblia Expandida",
    "slug": "biblia-expandida",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#00BCD4"
    },
    "android": {
      "package": "com.bibliaexpandida.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para fotografar páginas da Bíblia."
        }
      ]
    ]
  }
}
